DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# SPS Google login. Enable these together for an authenticated, multi-user Hub.
# Never commit a real Client Secret. The redirect URI must exactly match
# https://YOUR-HUB-DOMAIN/api/auth/callback/google in Google Cloud Console.
# SPS_GOOGLE_CLIENT_ID=
# SPS_GOOGLE_CLIENT_SECRET=
# SPS_AUTH_GOOGLE_ONLY=true
# SPS_AUTH_SECRET=replace-with-a-long-random-secret
# SPS_DEPLOYMENT_MODE=authenticated
# SPS_DEPLOYMENT_EXPOSURE=private
# SPS_AUTH_BASE_URL_MODE=explicit
# SPS_AUTH_PUBLIC_BASE_URL=https://YOUR-HUB-DOMAIN
# SPS_ALLOWED_HOSTNAMES=YOUR-HUB-DOMAIN

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
